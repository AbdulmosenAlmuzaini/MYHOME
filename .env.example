# ==============================================================================
# إعدادات Vercel Native Services (تضاف تلقائياً عند تفعيل Storage في Vercel)
# ==============================================================================

# Vercel Postgres (يتم توليدها تلقائياً عند إنشاء Postgres Database في Vercel)
POSTGRES_URL=postgres://default:xxx@xxx-pooler.postgres.vercel-storage.com:5432/verceldb
POSTGRES_PRISMA_URL=postgres://default:xxx@xxx-pooler.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://default:xxx@xxx.postgres.vercel-storage.com:5432/verceldb
POSTGRES_USER=default
POSTGRES_HOST=xxx.postgres.vercel-storage.com
POSTGRES_PASSWORD=xxx
POSTGRES_DATABASE=verceldb

# Vercel Blob Storage (يتم توليده تلقائياً عند إنشاء Blob Store في Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# كلمة مرور لوحة تحكم المشرفات الإدارية
ADMIN_PASSWORD=kimia2026
ADMIN_JWT_SECRET=your-secure-jwt-secret-key-for-admin-sessions
